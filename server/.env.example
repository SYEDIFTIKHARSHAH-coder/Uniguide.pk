# ============================================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE (Render / Production)
# Configure these variables in your Render Dashboard
# NEVER COMMIT REAL SECRETS TO GITHUB
# ============================================================

# Firebase Admin Service Account JSON (Paste single line JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=your_service_account_json_here

# Super Admin Email (Google Sign-In super_admin role)
SUPER_ADMIN_EMAIL=your_super_admin_email_here

# Admin Login Credentials (Hardcoded admin login form)
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here

# JWT Secret Key (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_64_char_hex_here

# Server Environment Settings
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://uniguid-pk.web.app

# Groq AI Service API Key & Model
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

